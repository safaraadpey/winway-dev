# Crypto deposit scanner — Railway Nixpacks (NOT Vercel Cron)
#
# Required
DATABASE_URL=
# Prefer NEXT_PUBLIC_* (used by deposit-core notify). SUPABASE_URL is accepted as alias.
NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash REST — MUST match Next.js / Vercel (Hot Watch set + locks)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chain APIs
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=

# Scheduling (Hot+Confirm / Warm / Cold)
# CRYPTO_HOT_CONFIRM_SCAN_INTERVAL_MS=15000
# CRYPTO_WARM_SCAN_INTERVAL_MS=30000
# CRYPTO_FULL_SCAN_INTERVAL_MS=21600000
# CRYPTO_FULL_SCAN_PAGE_SIZE=200
# Crash-recovery lock TTLs only (locks are deleted after each run)
# CRYPTO_HOT_CONFIRM_SCAN_LOCK_TTL_SEC=45
# CRYPTO_WARM_SCAN_LOCK_TTL_SEC=90
# CRYPTO_FULL_SCAN_LOCK_TTL_SEC=3600
#
# Legacy aliases (still accepted):
# CRYPTO_ACTIVE_SCAN_INTERVAL_MS → hot+confirm interval
# CRYPTO_ACTIVE_SCAN_LOCK_TTL_SEC → hot+confirm lock TTL

# Health — Node 20+ (Nixpacks). deposit-core uses `ws` for Realtime when needed.
# CRYPTO_DEPOSIT_HTTP_PORT=8080
