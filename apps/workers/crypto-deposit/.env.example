# Crypto deposit scanner — Railway Nixpacks (NOT Vercel Cron)
#
# Required
DATABASE_URL=
# Prefer NEXT_PUBLIC_* (used by deposit-core notify). SUPABASE_URL is accepted as alias.
NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash REST — shared with Next crypto engine (active address set + locks)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chain APIs
ETHERSCAN_API_KEY=
TRONGRID_API_KEY=

# Intervals (defaults match former Vercel cron schedules)
# CRYPTO_ACTIVE_SCAN_INTERVAL_MS=120000
# CRYPTO_FULL_SCAN_INTERVAL_MS=21600000
# CRYPTO_FULL_SCAN_PAGE_SIZE=200
# CRYPTO_ACTIVE_SCAN_LOCK_TTL_SEC=115
# CRYPTO_FULL_SCAN_LOCK_TTL_SEC=3600

# Health — Node 20+ (Nixpacks). deposit-core uses `ws` for Realtime when needed.
# CRYPTO_DEPOSIT_HTTP_PORT=8080
