# Supabase (service role — server only, never expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which loops this process runs (comma-separated)
# scheduler | draw-processor | room-loop | tournament-orchestrator | dev-player-scheduler | dev-player-processor
GAME_ENGINE_ROLES=scheduler,draw-processor,room-loop,tournament-orchestrator,dev-player-scheduler,dev-player-processor

# Scheduled/tick workers (manageWaitingRooms, draw loop, tournament tick, dev-player ticks).
# Default off — set true on production/Railway. Local dev stays off unless you explicitly enable it.
SCHEDULER_ENABLED=false

# Runtime mode during migration: legacy_db | hybrid | engine
# engine = TS business logic (marks/evaluate/heartbeat); wallet/settle stay DB RPCs
GAME_RUNTIME=engine

# HTTP health/metrics (optional)
GAME_ENGINE_HTTP_PORT=8080

# Worker tuning
DRAW_PROCESSOR_INTERVAL_MS=500
DRAW_PROCESSOR_BATCH_SIZE=100
# Max rooms processed in parallel per batch (serial draw order within each room)
DRAW_PROCESSOR_ROOM_CONCURRENCY=8
# Wake processor on draw_jobs enqueue (in-process + Realtime); set false for poll-only
DRAW_PROCESSOR_WAKE_ON_ENQUEUE=true
# Short drain on wake (reduces enqueue→pick latency); poll tick uses MAX_BATCHES_PER_TICK
DRAW_PROCESSOR_MAX_BATCHES_PER_WAKE=4
DRAW_PROCESSOR_MAX_BATCHES_PER_TICK=2
DRAW_PROCESSOR_MICRO_PICK_ON_ENQUEUE=true
DRAW_PROCESSOR_MICRO_PICK_BATCH_SIZE=1
DRAW_PROCESSOR_MAX_MICRO_PICKS_IN_FLIGHT=3
DRAW_PROCESSOR_PER_ROOM_ACTOR=true
# Requeue a failing job until attempts hits this, then park as 'failed'
DRAW_PROCESSOR_MAX_ATTEMPTS=10
# TTL (seconds) for the draw-processor Redis leader lock
DRAW_PROCESSOR_LOCK_TTL_SEC=30
# Full marks snapshot sync every N processed draws (0 = disabled; per-draw marks still persist)
ROOM_STATE_CHECKPOINT_EVERY=10
# Requeue draw_jobs stuck in processing (crash recovery)
DRAW_JOB_STALE_SEC=120
DRAW_JOB_REAP_INTERVAL_MS=30000
# Per-room lock while draining draw_jobs (prevents cross-replica desync; 0 = off)
DRAW_ROOM_LOCK_TTL_SEC=120
# Pick-path DB diagnostics (fetchPickDebugQueueState, pick_debug_snapshot). Off in production.
DRAW_PICK_DIAGNOSTICS=false
# Repair finished rooms missing full-win settlement (engine janitor tick)
ROOM_JANITOR_INTERVAL_MS=60000
ROOM_JANITOR_BATCH_LIMIT=20

ROOM_SCHEDULER_INTERVAL_MS=1000

# Room-actor live draw loop (requires room-loop in GAME_ENGINE_ROLES)
ROOM_LOOP_DISCOVERY_MS=1000
ROOM_LOOP_LEASE_SEC=30
ROOM_LOOP_MAX_ACTIVE_ROOMS=50
# Observe-only shadow parity for rollout debugging (default off)
# ENABLE_SHADOW_PARITY=true

TOURNAMENT_TICK_INTERVAL_MS=2000
TOURNAMENT_TICK_BATCH_LIMIT=50

# Dev players — independent of GAME_RUNTIME (replaces dev-schedule-worker edge fn)
DEV_PLAYER_SCHEDULER_INTERVAL_MS=60000
DEV_PLAYER_PROCESSOR_INTERVAL_MS=60000
DEV_PLAYER_PROCESSOR_BATCH_LIMIT=10
DEV_PLAYER_PROCESSING_STUCK_TIMEOUT_SEC=120
DEV_PLAYER_SCHEDULER_LOCK_TTL_SEC=55
DEV_PLAYER_PROCESSOR_LOCK_TTL_SEC=55

# Logging
LOG_LEVEL=info
# Draw perf logs: draw-performance (per job), draw-performance-metrics (aggregate), draw-performance-batch

# Upstash — option A: Redis protocol (ioredis, preferred for game-engine)
# REDIS_URL=rediss://default:...@....upstash.io:6379

# Upstash — option B: REST API (@upstash/redis)
# Required for multi-replica production (leader locks). Optional for local single-instance dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
