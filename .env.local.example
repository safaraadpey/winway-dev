# Supabase Configuration
# main (prod): copy to .env.local
# develop (staging): see .env.develop.local.example or run scripts/use-supabase-develop.ps1
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_ADMIN_ORIGIN=https://admin.dingmoney.org
NEXT_PUBLIC_MAIN_ORIGIN=https://dingmoney.org
MAIN_APP_HOST=dingmoney.org
ADMIN_APP_HOST=admin.dingmoney.org

# Upstash Redis — used by Crypto Deposit Engine (Hot Watch + price lock + cooldown).
# MUST match Railway crypto-deposit-worker UPSTASH_* so Hot registrations are scanned.
# Also used by Railway Game Engine for leader locks (see apps/engines/bingo/.env.example).
# If unset, Next.js falls back to in-memory store (single-instance / local only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- HamiPay deposit (server-only; never NEXT_PUBLIC_) ---
# DEPOSIT_DOMAIN_ENABLED=true
# DEPOSIT_ENVIRONMENT=development
# HAMIPAY_API_KEY=
# HAMIPAY_API_BASE_URL=
# HAMIPAY_RETURN_BASE_URL=https://dev.dingmoney.org
# HAMIPAY_AMOUNT_UNIT=rial
# DEPOSIT_MIN_AMOUNT_TOMAN=10000
# DEPOSIT_MAX_AMOUNT_TOMAN=500000000
# CRON_SECRET=
# HAMIPAY_MOCK=true

# Optional Bearer for manual /api/cron/* triggers (admin JWT also works).
# Auto crypto scanning: Railway workspace @dingmoney/crypto-deposit-worker + @dingmoney/deposit-core.
# CRON_SECRET=your_random_secret

# --- Crypto deposit engine (server-only) ---
# Etherscan V2 API Key (BEP-20 / BNB Chain, chainid=56)
ETHERSCAN_API_KEY=

# TronGrid API Key (TRC-20 / TRON)
TRONGRID_API_KEY=
