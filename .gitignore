# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
apps/engines/bingo/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
apps/engines/bingo/dist

# misc
.DS_Store
*.pem

# debug / package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cursor/*.log

# local env files
.env*.local
.env
apps/engines/bingo/.env
apps/engines/bingo/.env.*
!apps/engines/bingo/.env.example
!apps/engines/bingo/.env.develop.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# P4.1 — temporary workspace, scratch payloads, build/debug output
.tmp/
.tmp-*
/tmp/
logs/
build.log
build.err
build.debug.log
*.err

# local MCP / migration scratch payloads (never commit)
.tmp-*.json
.tmp-*.txt
.tmp-*.bin
.tmp-*.js
